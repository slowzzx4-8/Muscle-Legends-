local function atualizarAlvos(player, nomeDoMapa)
    if mapasAlvo[nomeDoMapa] and player ~= LocalPlayer then alvosValidos[player] = true else alvosValidos[player] = nil end
end

local function monitorarJogador(player)
    if player == LocalPlayer then return end
    local currentMap = player:WaitForChild("currentMap", 10)
    if currentMap then
        atualizarAlvos(player, currentMap.Value)
        currentMap:GetPropertyChangedSignal("Value"):Connect(function() atualizarAlvos(player, currentMap.Value) end)
    end
end

for _, player in ipairs(Players:GetPlayers()) do task.spawn(monitorarJogador, player) end
Players.PlayerAdded:Connect(function(p) task.spawn(monitorarJogador, p) end)
Players.PlayerRemoving:Connect(function(p) alvosValidos[p] = nil end)

local function atacarBrawlAlvo(character)
    local muscleEvent = LocalPlayer:FindFirstChild("muscleEvent")
    if not muscleEvent then return end

    if currentAttackMode == "Punch" then
        equiparTool("Punch")
        local tool = character:FindFirstChild("Punch")
        if tool then 
            tool:Activate()
            acelerarAnimacoes(character)
        end
        pcall(function() muscleEvent:FireServer("punch", "leftHand"); muscleEvent:FireServer("punch", "rightHand") end)
    elseif currentAttackMode == "Stomp" then
        equiparTool("Stomp")
        pcall(function() muscleEvent:FireServer("stomp") end)
    elseif currentAttackMode == "Ground Slam" then
        equiparTool("Ground Slam")
        pcall(function() muscleEvent:FireServer("groundSlam") end)
    end
end

