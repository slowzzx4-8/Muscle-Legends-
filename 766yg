local function equiparTool(toolName)
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if character and backpack then
        local tool = backpack:FindFirstChild(toolName) or character:FindFirstChild(toolName)
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if tool and humanoid and not character:FindFirstChild(toolName) then 
            humanoid:EquipTool(tool) 
        end
    end
end

local function getPosition(instance)
    if instance:IsA("Model") then
        return instance:GetPivot().Position
    elseif instance:IsA("BasePart") then
        return instance.Position
    end
    return nil
end

local function converterForca(jogador)
    if not jogador or not jogador:FindFirstChild("leaderstats") or not jogador.leaderstats:FindFirstChild("Strength") then return 0 end
    local str = string.lower(string.gsub(string.gsub(tostring(jogador.leaderstats.Strength.Value), ",", ""), " ", ""))
    local numero, sufixo = string.match(str, "^([%d%.]+)([a-z]*)$")
    if not numero then return 0 end
    return (tonumber(numero) or 0) * (multiplicadores[sufixo] or 1)
end

-- Busca os Bosses da lista dentro de BossArena
local function getActiveBossTarget()
    local events = workspace:FindFirstChild("Events")
    local arena = events and events:FindFirstChild("BossArena")
    
    if arena then
        for _, bossName in ipairs(validBossNames) do
            local boss = arena:FindFirstChild(bossName)
            if boss then
                local isAlive = true
                if boss:FindFirstChild("Humanoid") and boss.Humanoid.Health <= 0 then
                    isAlive = false
                end
                if isAlive then return boss end
            end
        end
    end
    return nil
end

local function isInBrawl()
    local currentMap = LocalPlayer:FindFirstChild("currentMap")
    return (currentMap and mapasAlvo[currentMap.Value])
end

