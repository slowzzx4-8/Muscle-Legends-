local function criarBotao(nome, pos_Y, textoInit, corNormal, corBorda)
    local btn = Instance.new("TextButton")
    btn.Name = nome
    btn.Size = UDim2.new(1, -20, 0, 35)
    btn.Position = UDim2.new(0, 10, 0, pos_Y)
    btn.BackgroundColor3 = corNormal
    btn.Text = textoInit
