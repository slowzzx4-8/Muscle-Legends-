-- 5. SISTEMA DO BOSS PRINCIPAL 
-- ==========================================
task.spawn(function()
    while task.wait(0.05) do
        if bossFarmActive and not isInBrawl() then
            local boss = getActiveBossTarget()
            local character = LocalPlayer.Character
            
            if character and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
                local humanoid = character.Humanoid
                local events = workspace:FindFirstChild("Events")
                local arena = events and events:FindFirstChild("BossArena")
                
                if arena then
                    if boss then
                        local bossRoot = boss:FindFirstChild("HumanoidRootPart") or boss.PrimaryPart or boss:FindFirstChildWhichIsA("BasePart")
                        if bossRoot then
                            -- Speed Hack no Boss Loop
                            humanoid.WalkSpeed = 100
                            
                            local distanciaCostas = 4.5 
                            local posicaoCostas = bossRoot.Position - (bossRoot.CFrame.LookVector * distanciaCostas)
                            
                            humanoid:MoveTo(posicaoCostas)
                            
                            equiparTool("Punch")
                            local tool = character:FindFirstChild("Punch")
                            if tool then 
                                tool:Activate() 
                                acelerarAnimacoes(character) 
                            end
                            
                            local muscleEvent = LocalPlayer:FindFirstChild("muscleEvent")
                            if muscleEvent then
                                pcall(function()
                                    muscleEvent:FireServer("punch", "leftHand")
                                    muscleEvent:FireServer("punch", "rightHand")
                                end)
                            end
                        end
                    else
                        -- Reseta a velocidade normal
                        humanoid.WalkSpeed = 16 
                        
                        local bossSpawn = arena:FindFirstChild("BossSpawn")
                        if bossSpawn then
                            local spawnPos = getPosition(bossSpawn)
                            if spawnPos then
                                humanoid:MoveTo(spawnPos)
                            end
                        end
                    end
                end
            end
        else
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.WalkSpeed = 16
            end
        end
    end
end)

