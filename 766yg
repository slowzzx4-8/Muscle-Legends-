task.spawn(function()
    while task.wait(0.05) do 
        if autoKill and isInBrawl() then
            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local lista = {}
                for alvo, _ in pairs(alvosValidos) do
                    if alvo.Character and alvo.Character:FindFirstChild("HumanoidRootPart") and alvo.Character:FindFirstChild("Humanoid") and alvo.Character.Humanoid.Health > 0 then
                        if isDentroDasAreas(alvo.Character.HumanoidRootPart.Position) then table.insert(lista, alvo.Character.HumanoidRootPart) end
                    else alvosValidos[alvo] = nil end
                end
                
                if #lista > 0 then
                    myRoot.Velocity = Vector3.zero; myRoot.RotVelocity = Vector3.zero
                    myRoot.CFrame = lista[1].CFrame * CFrame.new(0, 0, 3)
                    
                    local mEvent = LocalPlayer:FindFirstChild("muscleEvent")
                    if mEvent then
                        equiparTool("Punch")
                        local t = myChar:FindFirstChild("Punch")
                        if t then t:Activate(); acelerarAnimacoes(myChar) end
                        pcall(function() mEvent:FireServer("punch", "leftHand"); mEvent:FireServer("punch", "rightHand") end)
                    end
                end
            end
        end
    end
end)

