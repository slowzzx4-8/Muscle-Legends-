-- Boss Farm / Loop Movimentação Legitima (Ajustado para andar e manter 5 studs)
RunService.Heartbeat:Connect(function()
    if bossFarmActive and not isInBrawl() then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
            local humanoid = char.Humanoid
            local hrp = char.HumanoidRootPart
            if humanoid.Health > 0 then
                humanoid.WalkSpeed = 500 
                local boss = getActiveBossTarget()
                local arena = workspace:FindFirstChild("Events") and workspace.Events:FindFirstChild("BossArena")

                if arena and boss then
                    local bossRoot = boss:FindFirstChild("HumanoidRootPart") or boss.PrimaryPart or boss:FindFirstChildWhichIsA("BasePart")
                    local torso = boss:FindFirstChild("Torso") or boss:FindFirstChild("UpperTorso") or bossRoot

                    if bossRoot and torso then
                        -- Calcula a direção do Boss para o Player (ignorando Y para não bugar no chão)
                        local flatTorso = Vector3.new(torso.Position.X, hrp.Position.Y, torso.Position.Z)
                        local direcao = (hrp.Position - flatTorso).Unit
                        if direcao.Magnitude ~= direcao.Magnitude then direcao = Vector3.new(0, 0, 1) end -- Evita NaN
                        
                        -- Define o alvo sempre a exatos 5 studs de distância do Boss
                        local posAlvo = flatTorso + (direcao * 5)
                        humanoid:MoveTo(posAlvo)

                        -- Mantém o personagem virado para o Boss suavemente sem travar a caminhada
                        local bg = hrp:FindFirstChild("BossBodyGyro")
                        if not bg then
                            bg = Instance.new("BodyGyro")
                            bg.Name = "BossBodyGyro"
                            bg.MaxTorque = Vector3.new(0, 400000, 0)
                            bg.P = 15000
                            bg.Parent = hrp
                        end
                        bg.CFrame = CFrame.lookAt(hrp.Position, flatTorso)

                        -- Ataca se estiver próximo o suficiente (distância <= 8 para margem de erro)
                        if (hrp.Position - flatTorso).Magnitude <= 8 then
                            equiparTool("Punch")
                            local tool = char:FindFirstChild("Punch")
                            if tool then tool:Activate(); acelerarAnimacoes(char) end

                            local mEvent = LocalPlayer:FindFirstChild("muscleEvent")
                            if mEvent then pcall(function() mEvent:FireServer("punch", "leftHand"); mEvent:FireServer("punch", "rightHand") end) end
                        end
                    end
                elseif arena then
                    local bg = hrp:FindFirstChild("BossBodyGyro")
                    if bg then bg:Destroy() end
                    
                    local bossSpawn = arena:FindFirstChild("BossSpawn")
                    if bossSpawn then
                        local sPos = getPosition(bossSpawn)
                        if sPos then humanoid:MoveTo(sPos) end
                    end
                end
            end
        end
    else
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local bg = char.HumanoidRootPart:FindFirstChild("BossBodyGyro")
            if bg then bg:Destroy() end
        end
        if char and char:FindFirstChild("Humanoid") then char.Humanoid.WalkSpeed = 16 end
    end
end)

-- Brawl Monitoramento
local function monitorarJogador(p)
    if p == LocalPlayer then return end
    local currentMap = p:WaitForChild("currentMap", 10)
    if currentMap then
        if mapasAlvo[currentMap.Value] then alvosValidos[p] = true else alvosValidos[p] = nil end
        currentMap:GetPropertyChangedSignal("Value"):Connect(function()
            if mapasAlvo[currentMap.Value] then alvosValidos[p] = true else alvosValidos[p] = nil end
        end)
    end
end
for _, p in ipairs(Players:GetPlayers()) do task.spawn(monitorarJogador, p) end
Players.PlayerAdded:Connect(function(p) task.spawn(monitorarJogador, p) end)
Players.PlayerRemoving:Connect(function(p) alvosValidos[p] = nil end)

